# --- Optional: AI mode -------------------------------------------------
# If OPENAI_API_KEY is set, the /api/generate route uses the OpenAI API
# for higher-quality generation. If it is NOT set, the app still works:
# it falls back to a built-in heuristic generator based on the article's
# own text and keywords (no key, no cost).
OPENAI_API_KEY=

# Optional: which OpenAI model to use (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# --- Optional: Cloudflare Turnstile (bot protection) -------------------
# Leave both blank to disable. This project ships with a simple in-memory
# per-IP rate limit by default; see README.md ("Abuse protection") for how
# to add Turnstile later if you need stronger protection.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
